{
  "uid": "f1-historical-snowflake-local",
  "title": "F1 Historical Snowflake Marts",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Race summary mart",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-snowflake-datasource",
        "uid": "snowflake_historical"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT * FROM F1_RACE_SUMMARY LIMIT 100"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Race leaderboard mart",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-snowflake-datasource",
        "uid": "snowflake_historical"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT * FROM F1_RACE_LEADERBOARD LIMIT 100"
        }
      ]
    }
  ]
}
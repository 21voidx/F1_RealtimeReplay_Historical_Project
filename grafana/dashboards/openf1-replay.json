      "type": "timeseries",
      "title": "Speed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-openf1"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "sql",
          "rawSql": "SELECT event_time AS time, speed FROM openf1_replay.car_data WHERE $__timeFilter_ms(event_time) AND replay_id = '${replay_id}' ORDER BY event_time",
